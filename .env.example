# Copy this file to .env.local and fill in real credentials.
#
# NORMAL MODE REQUIRES REAL CREDENTIALS. Without GOOGLE_MAPS_API_KEY, searches
# are blocked with a clear configuration error — the app never silently
# substitutes mock businesses, fake ratings, or template AI text.

# ── Business discovery provider ─────────────────────────────────────────────
# Leave unset (or "google_places") for real data — this is the default and
# what normal use requires. Set to "mock" ONLY for isolated local/offline
# development against clearly-labeled sample data; never use mock in
# production, and the header always makes it obvious when mock is active.
BUSINESS_PROVIDER=google_places

# Required for real business discovery. Enable "Places API (New)" in Google
# Cloud Console and create an API key.
GOOGLE_MAPS_API_KEY=

# ── AI features (lead summary, discovery questions, outreach message) ──────
# Required for AI generation. Without it, generation is blocked with a clear
# "Groq API is not configured" error — there is no template/fake fallback.
# Get a key at console.groq.com.
GROQ_API_KEY=

# Production, general-purpose, reasoning-capable model on Groq. Change this if
# Groq deprecates it or you prefer a different hosted model.
GROQ_MODEL=openai/gpt-oss-120b

# ── Storage ──────────────────────────────────────────────────────────────
# Path to the local SQLite file. Created automatically on first run.
DATABASE_PATH=./data/ignis.sqlite

# ── Basic API protection (optional) ─────────────────────────────────────────
# If set, mutating API routes require this value in an "x-ignis-token" header.
# Leave empty for local/internal use on your own machine.
APP_ACCESS_TOKEN=
