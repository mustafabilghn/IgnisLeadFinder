# Copy this file to .env.local and fill in what you have.
# The app works with NONE of these set — it falls back to mock/dev mode.

# ── Business discovery provider ─────────────────────────────────────────────
# "mock" (default, no key needed) or "google_places"
BUSINESS_PROVIDER=mock

# Required only when BUSINESS_PROVIDER=google_places
# Enable "Places API (New)" in Google Cloud Console and create an API key.
GOOGLE_PLACES_API_KEY=

# ── AI features (lead summary, discovery questions, outreach message) ──────
# Required to get real AI text. Without it, the app returns clearly-labeled
# template output instead of calling an LLM (see section 12/23 of the spec).
ANTHROPIC_API_KEY=

# Small/cheap model is plenty for grounded summarization — keep cost low.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Storage ──────────────────────────────────────────────────────────────
# Path to the local SQLite file. Created automatically on first run.
DATABASE_PATH=./data/ignis.sqlite

# ── Basic API protection (optional) ─────────────────────────────────────────
# If set, mutating API routes require this value in an "x-ignis-token" header.
# Leave empty for local/internal use on your own machine.
APP_ACCESS_TOKEN=
